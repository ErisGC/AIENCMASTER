PORT=3001
# Dominio(s) del portal. Admite VARIOS separados por coma; el PRIMERO es el
# canónico (el que el proxy web reenvía al backend). Durante un cambio de
# dominio se listan el nuevo y el viejo para no cortar el acceso, y luego se
# retira el anterior.
#   Ej: WEB_ORIGIN=https://aienc.org,https://www.aienc.org,https://aiencmaster.vercel.app
WEB_ORIGIN=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=aienc

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required. Generate a long random secret before running the admin security module.
ADMIN_SESSION_SECRET=
# Duración de la sesión activa. 2592000 = 30 días, alineado con el TTL del
# dispositivo de confianza. La sesión se RENUEVA en cada apertura de la app, y
# la app vuelve a pedir la contraseña de la cuenta cada 14 días por su cuenta;
# un valor corto aquí (p. ej. 43200 = 12 h) hace que se pida la contraseña casi
# a diario, saltándose ese control.
ADMIN_SESSION_TTL_SECONDS=2592000
ADMIN_PENDING_SESSION_TTL_SECONDS=86400
ADMIN_TRUSTED_DEVICE_TTL_SECONDS=2592000
ADMIN_ACCESS_REQUEST_TTL_SECONDS=86400
ADMIN_ACCESS_REQUEST_RETRY_COOLDOWN_SECONDS=3600

# Keep disabled during normal operation. Enable only for the first controlled root bootstrap.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_SECRET=

# Keep disabled during normal operation. Enable only during an exceptional break-glass recovery.
ADMIN_ROOT_RECOVERY_ENABLED=false
ADMIN_ROOT_RECOVERY_SECRET=
